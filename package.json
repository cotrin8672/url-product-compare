{
  "name": "url-product-compare",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pages": "node tooling/build-cloudflare-pages.mjs",
    "build:api-libraries": "pnpm --filter @app/rakuten-api --filter @app/valuecommerce-api --filter @app/jev-api --filter @app/amazon-api --filter @app/yahoo-shopping-api build",
    "firebase": "firebase",
    "format": "oxfmt --write . && prettier --write \"apps/web/src/**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"apps/web/src/**/*.astro\"",
    "lint": "pnpm --filter @app/web prepare:site && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "pnpm --filter @app/web prepare:site && tsc --noEmit && pnpm -r --if-present typecheck",
    "knip": "knip --include-entry-exports",
    "test:guardrails": "node tooling/guardrails.test.mjs",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test:guardrails && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@types/node": "24.10.13",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.32.1",
    "knip": "6.38.0",
    "oxfmt": "0.70.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.5"
}
