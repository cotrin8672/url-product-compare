{
  "name": "url-product-compare",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "knip": "knip --include-entry-exports",
    "test:guardrails": "node tooling/guardrails.test.mjs",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test:guardrails && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@types/node": "24.10.13",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.38.0",
    "oxfmt": "0.70.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.5"
}
