# Local demo: leave the following entries commented out.
# For live Rakuten data and monetized links, set all five values on the API server only.
# Never set VITE_* variables for credentials or commit .env.
# RAKUTEN_APPLICATION_ID=YOUR_REGISTERED_APPLICATION_ID
# RAKUTEN_ACCESS_KEY=YOUR_REGISTERED_ACCESS_KEY
# RAKUTEN_AFFILIATE_ID=YOUR_RAKUTEN_AFFILIATE_ID
# RAKUTEN_ALLOWED_ORIGIN=https://YOUR_PUBLIC_SITE_HOST
# API_ACCESS_TOKEN=YOUR_RANDOM_BASE64URL_TOKEN_AT_LEAST_32_CHARACTERS
# This token stays on the server; the public consumer gateway accepts URL-only browser requests.
# Local browser origins default to http://127.0.0.1 on ports 5173, 5174 and 5175.
# Setting API_ALLOWED_ORIGIN replaces the local defaults with one explicit origin.
# API_ALLOWED_ORIGIN=https://YOUR_PUBLIC_SITE_HOST

# Public build settings only. Set all service origins for Cloudflare/remote API builds.
# PRODUCTS_SITE_ORIGIN=https://products.example.com
# FURUSATO_SITE_ORIGIN=https://furusato.example.com
# SECURITIES_SITE_ORIGIN=https://securities.example.com
# SITE_ORIGIN=https://products.example.com
# PUBLIC_API_BASE=https://YOUR_PUBLIC_API_HOST

# Optional Jev extraction for /api/comparisons and /api/compare. Numeric comparisons never use AI.
# JEV_API_KEY=YOUR_JEV_API_KEY
# JEV_MODEL=jev-1.13.0

# Legacy diagnostic AI: optional. Enables /api/candidates; server only.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_MODEL=gpt-6-luna
