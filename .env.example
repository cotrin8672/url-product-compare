# Local demo: leave the following entries commented out.
# For live Rakuten data and monetized links, set ALL six values on the API server only.
# Never set VITE_* variables for credentials or commit .env.
# RAKUTEN_APPLICATION_ID=YOUR_REGISTERED_APPLICATION_ID
# RAKUTEN_ACCESS_KEY=YOUR_REGISTERED_ACCESS_KEY
# RAKUTEN_AFFILIATE_ID=YOUR_RAKUTEN_AFFILIATE_ID
# RAKUTEN_ALLOWED_ORIGIN=https://main.d3f6j2d66bsp2x.amplifyapp.com
# Internal review/stop deadline, not an expiry issued by Rakuten.
# RAKUTEN_DATA_AUTHORIZED_UNTIL=YOUR_FETCH_DISPLAY_AND_AFFILIATE_REVIEW_DEADLINE_IN_UTC
# API_ACCESS_TOKEN=YOUR_RANDOM_BASE64URL_TOKEN_AT_LEAST_32_CHARACTERS

# Main AI: optional. Enables /api/candidates after a key is supplied; server only.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_MODEL=gpt-6-luna
