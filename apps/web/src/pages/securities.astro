---
import site from "../../.generated/site.json";
import "../style.css";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="api-base" content={site.apiBase} />
    <meta name="robots" content="noindex,follow" />
    <title>証券会社の比較｜手数料・NISA・積立ポイント</title>
    <meta
      name="description"
      content="SBI・楽天・マネックスの手数料と積立ポイントを、公式の適用条件に基づいて比較できます。"
    />
  </head>
  <body>
    <section id="public-content" class="public-content">
      <h1>証券会社の比較</h1>
      <p>条件を入力して手数料・積立ポイントを比較できます。</p>
    </section>
    <noscript>
      <p>条件の計算にはJavaScriptを有効にしてください。</p>
    </noscript>
    <div id="app"></div>
    <script src="../index.tsx"></script>
  </body>
</html>
