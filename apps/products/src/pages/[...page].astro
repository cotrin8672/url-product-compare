---
import site from "../../.generated/site.json";
import ProductLayout from "../layouts/ProductLayout.astro";
import GuideArtwork from "../components/GuideArtwork.astro";
import GuideIndex from "../components/GuideIndex.astro";
import GuideArticle from "../components/GuideArticle.astro";
import { guides } from "../content/editorial.js";

export const getStaticPaths = (): ReadonlyArray<
  Readonly<{ params: Readonly<{ page: string | undefined }>; props: Props }>
> =>
  [
    ...site.pages,
    ...guides.map((guide) => ({
      route: `/guides/${guide.slug}/`,
      title: guide.title,
      description: guide.description,
      heading: guide.title,
      intro: guide.takeaway,
      kind: "guide",
      links: [],
      labels: [],
      breadcrumbs: [
        { name: "選び方ガイド", route: "/guides/" },
        { name: guide.title, route: `/guides/${guide.slug}/` },
      ],
    })),
    {
      route: "/guides/",
      title: "選び方ガイド",
      description: "掲載価格と支払総額の違い、仕様の読み方、購入前の確認手順をまとめました。",
      heading: "選び方ガイド",
      intro: "比較結果を購入判断に使うときの確認ポイントです。",
      kind: "guide-index",
      links: [],
      labels: [],
      breadcrumbs: [{ name: "選び方ガイド", route: "/guides/" }],
    },
  ].map((page) => ({
    params: { page: page.route === "/" ? undefined : page.route.slice(1, -1) },
    props: { page },
  }));
type Props = Readonly<{
  page: Readonly<{
    route: string;
    title: string;
    description: string;
    heading: string;
    intro: string;
    kind: string;
    breadcrumbs: ReadonlyArray<Readonly<{ name: string; route: string }>>;
  }>;
}>;
const { page } = Astro.props;
const guide = guides.find((entry) => page.route === `/guides/${entry.slug}/`);
const faq = [
  {
    question: "どんな商品を比較できますか？",
    answer:
      "楽天市場の新品商品URLに対応しています。カテゴリを選ぶ必要はなく、商品情報から種類を判定して類似候補を探すため、家電・PC以外の商品も対象です。商品情報を取得できない場合や、類似候補・仕様が足りない場合は比較できないことがあります。",
  },
  {
    question: "AmazonやYahoo!ショッピングのURLは使えますか？",
    answer: "現在は使えません。対応しているのは楽天市場の新品商品URLのみです。",
  },
  {
    question: "おすすめ度（100点）は何を表していますか？",
    answer:
      "今回の候補の中で、確認できた仕様を相対的に点数化した目安です。候補が変わると点数も変わり、実測の性能や満足度を示すものではありません。「—」は値を確認できなかった項目で、0点や機能なしを意味しません。",
  },
  {
    question: "表示価格に送料やポイントは含まれますか？",
    answer:
      "含みません。表示するのは取得時点の掲載価格です。送料・ポイント・クーポンや在庫は変わるため、購入前に販売ページで確認してください。",
  },
  {
    question: "このサイトで購入できますか？",
    answer:
      "当サイトは販売や注文の受付を行いません。購入・配送・返品はリンク先の販売店でのお手続きになります。",
  },
];
---

<ProductLayout
  site={site}
  title={page.title}
  description={page.description}
  route={page.route}
  legacy={page.kind === "legacy"}
  breadcrumbs={page.breadcrumbs}
>
  {page.kind === "guide-index" ? (
    <GuideIndex />
  ) : guide !== undefined ? (
    <GuideArticle guide={guide} />
  ) : page.kind === "legacy" ? (
    <>
      <section id="main-content" class="sr-only">
        <h1>{page.heading}</h1>
        <p>{page.intro}</p>
      </section>
      <div id="app"></div>
      <script src="../index.tsx"></script>
    </>
  ) : (
    <main id="main-content" class="compare-page">
      <h1 class="sr-only">{page.heading}</h1>
      <div id="compare-tool" class="compare-tool">
        <div id="app"></div>
        <noscript>
          <p class="compare-noscript">比較の実行にはJavaScriptを有効にしてください。</p>
        </noscript>
      </div>
      <script src="../index.tsx"></script>
      <section class="home-features" aria-labelledby="features-heading">
        <div class="home-section-head">
          <h2 id="features-heading">買う前に読んでおきたい</h2>
          <a href="/guides/">
            すべて見る <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="feature-grid">
          {guides.map((entry) => (
            <a class={`feature-card feature-card--${entry.slug}`} href={`/guides/${entry.slug}/`}>
              <div class="feature-art">
                <GuideArtwork topic={entry.slug} />
              </div>
              <div class="feature-copy">
                <span>{entry.topicLabel}</span>
                <h3>{entry.title.split("｜")[0]}</h3>
                <span class="feature-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
      <div class="home-info">
        <section id="faq" class="home-faq" aria-labelledby="faq-heading">
          <h2 id="faq-heading">よくある質問</h2>
          {faq.map((entry) => (
            <details>
              <summary>{entry.question}</summary>
              <p>{entry.answer}</p>
            </details>
          ))}
        </section>
      </div>
    </main>
  )}
</ProductLayout>
