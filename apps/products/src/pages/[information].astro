---
import site from "../../.generated/site.json";
import ProductLayout from "../layouts/ProductLayout.astro";
import { informationPages } from "../content/editorial.js";
import { publisher } from "../content/publisher.js";
type Props = Readonly<{ page: (typeof informationPages)[number] }>;
export const getStaticPaths = (): ReadonlyArray<
  Readonly<{ params: Readonly<{ information: string }>; props: Props }>
> => informationPages.map((page) => ({ params: { information: page.slug }, props: { page } }));
const { page } = Astro.props;
const route = `/${page.slug}/`;
---

<ProductLayout
  site={site}
  title={page.title}
  description={page.description}
  route={route}
  breadcrumbs={[{ name: page.title, route }]}
>
  <main id="main-content" class="editorial-wrap">
    <article class="editorial-article">
      <h1>{page.title}</h1>
      <p class="article-meta">更新日：2026年10月31日</p>
      {page.slug === "about" && publisher.name.length > 0 && (
        <section>
          <h2>運営者情報</h2>
          <p>運営者：{publisher.name}</p>
          {publisher.contactUrl.length > 0 && (
            <p>
              <a href={publisher.contactUrl}>お問い合わせ</a>
            </p>
          )}
        </section>
      )}
      {page.slug === "about" && (
        <>
          <p class="editorial-lead">
            気になる商品の違いを整理し、自分の用途に合う候補を選ぶための商品比較サービスです。
          </p>
          <h2>できること</h2>
          <p>
            楽天市場の新品商品URLから、類似商品の価格と確認できた仕様を比較できます。ノートPC・デスクトップPC・タブレット・スマートフォン・モニター・テレビの選び方ガイドも提供しています。
          </p>
          <h2>比較だけでは決められないこと</h2>
          <p>
            すべての販売店や商品を網羅した最安値検索、実機による試験、個別の用途での動作保証は行っていません。接続の互換性、購入する構成、保証などは、メーカーと販売店の情報で確認してください。
          </p>
          <h2>販売・注文について</h2>
          <p>
            当サイトは商品の販売や注文受付を行いません。購入・決済・配送・返品はリンク先の販売店との取引になります。
          </p>
          <h2>情報の扱い</h2>
          <p>
            比較の対象や採点方法は<a href="/methodology/">比較のしくみ</a>に、記事と広告の扱いは
            <a href="/editorial-policy/">編集・広告掲載方針</a>に記載しています。
          </p>
        </>
      )}
      {page.slug === "editorial-policy" && (
        <>
          <p class="editorial-lead">
            商品の価格と仕様を整理する機能と、選ぶ基準を説明する記事を提供します。
          </p>
          <h2>記事と出典</h2>
          <p>
            選び方ガイドは、用途・確認すべき条件・購入前の手順を整理した解説です。メーカーなどの公式情報を参照する記事には、確認に使えるリンクを掲載します。一般的な選び方の説明と、特定商品の実際の仕様を区別します。
          </p>
          <p>
            掲載中のガイドは実機を使ったレビューではありません。実施していない性能試験、使用経験、専門家の監修を装う表記はしません。説明用の架空例はその旨を明記します。
          </p>
          <h2>比較結果と自動処理</h2>
          <p>
            比較結果は、取得できた商品情報をもとに作成します。自動抽出やAIの補助を使う場合があり、仕様の不足や誤りが起こる可能性があります。点数は実機試験の結果ではなく、未確認の情報は未確認として表示します。詳しくは
            <a href="/methodology/">比較のしくみ</a>をご覧ください。
          </p>
          <h2>アフィリエイト広告</h2>
          <p>
            当サイトはアフィリエイト広告を利用しています。商品リンクを経由した購入などにより、運営者に報酬が入る場合があります。比較スコアや価格順位の計算に報酬額を使うことはありません。
          </p>
          <p>
            現在の商品URL比較は楽天市場に対応しています。Amazon・Yahoo!ショッピングの商品URLの比較は提供していません。広告への参加や対応範囲が変わる際は、関連する表示と方針も更新します。
          </p>
          <h2>更新と購入時の確認</h2>
          <p>
            記事には公開・更新日を表示します。商品情報は変わるため、比較時点の価格・仕様と購入時点の条件が一致するとは限りません。販売ページと公式仕様を最終確認してください。
          </p>
        </>
      )}
      {page.slug === "privacy" && (
        <>
          <p class="editorial-lead">
            商品比較で扱う情報と、外部サービスを利用する場面を説明します。
          </p>
          <h2>入力する商品情報</h2>
          <p>
            入力した商品URL、補助の商品名、比較条件を、商品情報の取得・候補の検索・比較結果の作成のためにサーバーへ送信します。注文履歴やマイページなど、氏名・住所・注文番号を含むURLは入力しないでください。
          </p>
          <h2>ブラウザーとサーバーへの保存</h2>
          <p>
            比較処理を再開するため、ジョブ識別子・アクセスキー・有効期限・カテゴリなどをブラウザーのセッションストレージに保存します。通常はタブのセッション中に使われます。共有端末では比較後にタブを閉じ、必要に応じてブラウザーのサイトデータを削除してください。
          </p>
          <p>
            サーバーでは比較処理と結果の提供に必要な情報を保持します。比較結果には表示期限があり、期限が過ぎた結果は再取得が必要です。表示期限と保存データの削除時点は同一とは限りません。
          </p>
          <h2>通信先と利用目的</h2>
          <ul class="editorial-checklist">
            <li>Cloudflare：サイトの配信、通信の保護。</li>
            <li>
              Amazon Web Services：比較APIの実行、比較処理・結果の保持、障害調査や不正利用対策。
            </li>
            <li>楽天ウェブサービス：商品情報と候補の検索。</li>
            <li>Jev：自動抽出・評価を利用する場合の商品情報の整理。</li>
          </ul>
          <p>
            サイトやAPIへのアクセスに伴い、配信・実行基盤がIPアドレスやリクエスト情報などを処理する場合があります。商品画像の読み込みや外部リンクへの移動でも、接続先へ通常の通信情報が送られます。
          </p>
          <h2>広告リンクと外部サイト</h2>
          <p>
            広告リンクを開くと、広告配信事業者や販売店で、成果計測のためCookieなどが使用される場合があります。移動先では各事業者の方針が適用されます。
            <a href="https://privacy.rakuten.co.jp/">楽天グループの個人情報保護方針</a>
            もご確認ください。
          </p>
          <h2>方針の更新</h2>
          <p>
            入力項目、計測サービス、広告の対応範囲が変わった際は、この説明を更新します。ここに記載した比較以外の目的で、個人情報を入力する必要はありません。
          </p>
        </>
      )}
      {page.slug === "terms" && (
        <>
          <p class="editorial-lead">
            当サイトは商品選びを補助する情報サービスです。次の点を確認してご利用ください。
          </p>
          <h2>情報と比較の範囲</h2>
          <p>
            価格、在庫、仕様は取得時点の情報です。内容の完全性、すべての商品を網羅していること、個別の用途での動作を保証するものではありません。比較スコアや順位は、候補と確認できた情報に基づく目安です。
          </p>
          <h2>購入先との取引</h2>
          <p>
            注文、支払い、配送、保証、返品の条件は販売店で確認してください。当サイトは販売契約の当事者ではなく、注文内容の変更や返金を受け付けることはできません。
          </p>
          <h2>入力と利用上の注意</h2>
          <p>
            公開された商品ページのURLを使い、個人情報や秘密情報を入力しないでください。サービスへの過度な自動アクセス、不正アクセス、他の利用者の比較結果へアクセスする行為、第三者の権利を侵害する利用を行わないでください。
          </p>
          <h2>外部情報と権利</h2>
          <p>
            商品画像、名称、商標などの権利は各権利者に帰属します。当サイトに表示された情報を、利用権限があることを確認せずに再配布しないでください。
          </p>
          <h2>サービスの変更</h2>
          <p>
            保守や外部サービスの状況により、機能の停止や対応範囲の変更が生じる場合があります。法令上認められない責任の免除を定めるものではありません。
          </p>
        </>
      )}
    </article>
  </main>
</ProductLayout>
