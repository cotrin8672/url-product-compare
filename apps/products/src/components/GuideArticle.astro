---
import GuideList from "./GuideList.astro";
import { editorialDate, guides } from "../content/editorial.js";
import type { Guide } from "../content/editorial.js";
type Props = Readonly<{ guide: Guide }>;
const { guide } = Astro.props;
const related = guides.filter((entry) => entry.slug !== guide.slug);
---

<main id="main-content" class="editorial-wrap">
  <nav class="breadcrumbs" aria-label="パンくず">
    <a href="/">トップ</a>
    <span>/</span>
    <a href="/guides/">選び方ガイド</a>
    <span>/</span>
    <span>{guide.topicLabel}</span>
  </nav>
  <article class="editorial-article">
    <header>
      <p class="eyebrow">{guide.topicLabel}</p>
      <h1>{guide.title}</h1>
      <p class="article-meta">
        公開・更新：<time datetime={editorialDate}>2026年10月31日</time> ·
        選び方の解説（実機レビューではありません）
      </p>
    </header>
    <aside class="editorial-takeaway">
      <strong>このガイドのポイント</strong>
      <p>{guide.takeaway}</p>
    </aside>
    <nav class="article-toc" aria-label="記事の目次">
      <details>
        <summary>目次（{guide.sections.length}項目）</summary>
        <ol>
          {guide.sections.map((section, index) => (
            <li>
              <a href={`#section-${index + 1}`}>{section.heading}</a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
    {guide.sections.map((section, index) => (
      <section id={`section-${index + 1}`}>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {section.checklist !== undefined && (
          <ul class="editorial-checklist">
            {section.checklist.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))}
    {guide.sources.length > 0 && (
      <section class="article-sources">
        <h2>確認に使える情報</h2>
        <p>
          メーカーなどの公式情報、または当サイトの説明です。個別製品の条件は購入する型番の案内で確認してください。
        </p>
        <ul>
          {guide.sources.map((source) => (
            <li>
              <a href={source.href}>{source.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <aside class="editorial-callout">
      <p>楽天市場の新品商品URLから、類似商品の価格と仕様を比較できます。</p>
      <a class="editorial-button" href="/">
        商品URLを入力する
      </a>
    </aside>
  </article>
  <section class="related-guides" aria-labelledby="related-heading">
    <h2 id="related-heading">ほかのガイド</h2>
    <GuideList entries={related} />
  </section>
</main>
