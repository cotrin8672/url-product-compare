      <rect
        x="89"
        y="28"
        width="109"
        height="115"
        rx="8"
        fill="#fbfefd"
        stroke="#75a697"
        stroke-width="2"
      />
      <rect x="117" y="19" width="55" height="19" rx="6" fill="#244a7c" />
