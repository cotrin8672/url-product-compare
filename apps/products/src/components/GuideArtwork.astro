---
type Props = Readonly<{ topic: string }>;
const { topic } = Astro.props;
---

<svg viewBox="0 0 320 160" fill="none" aria-hidden="true" class="guide-artwork">
  {topic === "memory-storage" ? (
    <>
      <circle cx="243" cy="35" r="68" fill="#cbdcf9" />
      <rect x="51" y="40" width="141" height="81" rx="10" fill="#244a7c" />
      <rect x="62" y="51" width="119" height="57" rx="3" fill="#f7fbff" />
      <path d="M39 129h164l-12-14H51l-12 14Z" fill="#789ac7" />
      <rect x="130" y="63" width="122" height="38" rx="5" fill="#5c978a" />
      {[145, 173, 201, 229].map((x) => (
        <rect x={x} y="72" width="16" height="17" rx="2" fill="#e3f5e9" />
      ))}
      <path
        d="M144 101v9m14-9v9m14-9v9m14-9v9m14-9v9m14-9v9m14-9v9m14-9v9"
        stroke="#c99e4e"
        stroke-width="5"
      />
      <rect
        x="207"
        y="104"
        width="66"
        height="37"
        rx="6"
        fill="#fcfdff"
        stroke="#789ac7"
        stroke-width="2"
