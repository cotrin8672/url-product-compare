        <>
          <rect x="105" y={y - 7} width="15" height="15" rx="3" fill="#d2eadf" />
          <path d={`m108 ${y} 4 4 6-9`} stroke="#447d68" stroke-width="2" />
          <path d={`M132 ${y}h46`} stroke="#8cb6a7" stroke-width="5" stroke-linecap="round" />
        </>
      ))}
      <circle cx="221" cy="106" r="28" fill="#e8f3ef" stroke="#244a7c" stroke-width="7" />
