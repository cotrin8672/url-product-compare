---
import site from "../../.generated/site.json";
import { serviceLinks } from "@app/site-config";
import "@app/ui/base.css";
import "../furusato.css";
const page = site.pages[0];
if (page === undefined) {
  throw new Error("Missing service home page");
}
const canonical = site.siteOrigin.length > 0 ? site.siteOrigin + "/" : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="api-base" content={site.apiBase} />
    <meta name="service-products" content={site.serviceOrigins.products} />
    <meta name="service-furusato" content={site.serviceOrigins.furusato} />
    <meta name="service-securities" content={site.serviceOrigins.securities} />
    <meta
      name="robots"
      content={
        canonical === null || page.kind === "securities" ? "noindex,nofollow" : "index,follow"
      }
    />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    {canonical !== null && <link rel="canonical" href={canonical} />}
  </head>
  <body>
    <section id="public-content" class="public-content">
      <h1>{page.heading}</h1>
      <p>{page.intro}</p>
      <nav aria-label="比較サービス">
        {serviceLinks(site.serviceOrigins).map((service) => (
          <a href={service.href}>{service.label}</a>
        ))}
      </nav>
    </section>
    <noscript>
      <p>比較の実行にはJavaScriptを有効にしてください。</p>
    </noscript>
    <div id="app"></div>
    <script src="../index.tsx"></script>
  </body>
</html>
